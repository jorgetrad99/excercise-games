{
  "name": "move-arcade",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node scripts/e2e-lock.mjs wait tsc && tsc --noEmit -p .",
    "lint": "node scripts/e2e-lock.mjs wait eslint && eslint .",
    "test": "vitest run",
    "test:smoke": "playwright test --project=smoke --project=perf",
    "vendor:models": "node scripts/vendor-models.mjs",
    "verify": "pnpm typecheck && pnpm lint && pnpm test && pnpm test:smoke",
    "latency:gestures": "vitest run --config vitest.tools.config.ts gesture-latency",
    "latency:pipeline": "playwright test --project=tools pipeline-latency",
    "latency:judder": "vitest run --config vitest.tools.config.ts frame-judder",
    "tune:boxing": "vitest run --config vitest.tools.config.ts boxing-tune"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "1.0.1",
    "three": "0.186.0"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@types/node": "22.20.3",
    "@types/three": "0.186.0",
    "eslint": "10.10.0",
    "prettier": "3.9.7",
    "typescript": "6.0.3",
    "typescript-eslint": "8.70.0",
    "vite": "8.3.0",
    "vitest": "5.0.1"
  }
}
